{
  "expo": {
    "name": "Kanka Chat",
    "slug": "kanka-chat",
    "scheme": "kanka",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "android": {
      "package": "com.kanka.chat",
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.BROADCAST_CLOSE_SYSTEM_DIALOGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.USE_FINGERPRINT",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.kanka.chat",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sohbete fotoğraf ve video gönderebilmen için galerine erişim gerekiyor.",
          "cameraPermission": "Sohbete fotoğraf çekip gönderebilmen için kamera izni gerekiyor.",
          "microphonePermission": "Video çekerken sesi kaydetmek için mikrofon izni gerekiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/bildirim-ikonu.png",
          "color": "#D4FF00",
          "defaultChannel": "mesajlar"
        }
      ],
      "./plugins/with-stat-icon.js",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Görüntülü görüşme için kamera izni gerekiyor.",
          "microphonePermission": "Sesli odalarda ve aramalarda konuşabilmen için mikrofon izni gerekiyor."
        }
      ],
      "./plugins/with-voice-service.js",
      "./plugins/with-proguard.js",
      [
        "expo-audio",
        {
          "microphonePermission": "Sesli mesaj ve sesli sohbet için mikrofonun kullanılır.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "./plugins/with-screen-share.js",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}