{
  "expo": {
    "name": "Kanka Chat",
    "slug": "kanka-chat",
    "scheme": "kanka",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "android": {
      "package": "com.kanka.chat",
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.BROADCAST_CLOSE_SYSTEM_DIALOGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kankahq.com",
              "pathPrefix": "/davet/"
            },
            {
              "scheme": "https",
              "host": "kankahq.com",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.kanka.chat",
      "supportsTablet": false,
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:kankahq.com"
      ],
      "config": {
        "usesNonExemptEncryption": true
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sesli odalarda konuşmak, arama yapmak ve sesli mesaj kaydetmek için mikrofonun kullanılır.",
        "NSCameraUsageDescription": "Görüntülü görüşmede kameranı açmak ve sohbete fotoğraf çekip göndermek için kamera kullanılır.",
        "NSPhotoLibraryUsageDescription": "Sohbete ya da profiline koymak istediğin fotoğrafı seçebilmen için.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": true,
        "CFBundleDevelopmentRegion": "tr",
        "NSFaceIDUsageDescription": "Uygulama kilidini Face ID ile açabilmen için."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherDataTypes",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCustomerSupport",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sohbete fotoğraf ve video gönderebilmen için galerine erişim gerekiyor.",
          "cameraPermission": "Görüntülü görüşmede kameranı açmak ve sohbete fotoğraf çekip göndermek için kamera kullanılır.",
          "microphonePermission": "Sesli odalarda konuşmak, arama yapmak ve sesli mesaj kaydetmek için mikrofonun kullanılır."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/bildirim-ikonu.png",
          "color": "#D4FF00",
          "defaultChannel": "mesajlar",
          "mode": "production"
        }
      ],
      "./plugins/with-stat-icon.js",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Görüntülü görüşmede kameranı açmak ve sohbete fotoğraf çekip göndermek için kamera kullanılır.",
          "microphonePermission": "Sesli odalarda konuşmak, arama yapmak ve sesli mesaj kaydetmek için mikrofonun kullanılır."
        }
      ],
      "./plugins/with-voice-service.js",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulama kilidini Face ID ile açabilmen için."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Kanka",
              "label": "Kanka",
              "description": "Çevrimiçi arkadaşlar, dolu sesli odalar ve kısayollar",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/with-proguard.js",
      [
        "expo-audio",
        {
          "microphonePermission": "Sesli odalarda konuşmak, arama yapmak ve sesli mesaj kaydetmek için mikrofonun kullanılır.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": false
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "video/*",
              "audio/*",
              "application/*"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "video/*"
            ]
          }
        }
      ],
      "./plugins/with-screen-share.js",
      "expo-iap",
      "./plugins/with-ios-signing.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
